NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY

# Предпочтительный серверный ключ нового формата. Никогда не добавляйте NEXT_PUBLIC_ к этой переменной.
SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_KEY
# Только для старых проектов как временный fallback:
# SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVICE_ROLE_KEY

# Предпочтительно: immutable UUID операторов из Auth. Если список непустой, email fallback отключается.
FLOWPAY_ADMIN_USER_IDS=00000000-0000-0000-0000-000000000000
# Fallback для первоначальной настройки: только подтверждённые email.
FLOWPAY_ADMIN_EMAILS=owner@your-domain.com
# Боевой HTTPS-адрес приложения.
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Обязательно для встроенного ежедневного maintenance cron.
# Сгенерируйте случайную строку минимум 32 байта, например: openssl rand -hex 32
CRON_SECRET=replace-with-a-long-random-secret
